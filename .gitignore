# Stand customization model. The platform seeds it (fixed metaId, layer 4);
# live sync may rewrite Local/ or Tenant/ from the running Core. It is not a
# product — one commit of Local/model.json put Local=1.0.0 on the catalogue.
Local/
Tenant/
# Anchored and slashed ON PURPOSE. A bare "Test*" has no slash, so git matched it
# against EVERY path component — which made it a rule about "Tests/" folders, not
# about a stand model. It silently swallowed 104 server-owned files: 52 integration
# tests across HR, Production, Purchasing, Sales, Tax and TestBench. Already-tracked
# tests survived (gitignore does not touch tracked files), so nothing looked wrong
# until a NEW test was written and never reached a commit.
TestBench/
TestBenchExt/

# Derived — regenerated by ZuloOne on every export
.generated/
_unassigned/
ZuloOne.Workspace.csproj
.zuloone-export-manifest.json
bin/
obj/
*.conflict

# Integration-test artifacts. The stand syncs this folder, so anything a test
# creates is exported here. They are transient and must never be committed.
# Sweep the stand with POST /api/dev/test-artifacts/sweep to remove them.
#
# Do NOT use a bare "ends in 8 hex" rule on files. Digits are valid hex, so a
# job script named …_1788463549156 disappeared from git while its Job stayed —
# every import then died on FK_MetaJobs_MetaScripts_ScriptMetaId. Match only
# the shapes tests and the exporter actually write.

# Test model folders: "<Prefix><8 hex>/" from ApiFixture.Suffix.
*[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]/

# Test number sequences: Foo<8 hex>Id.json
*[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]Id.json

# Exporter collision copies: same caption, hyphen + 8 hex.
*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].json
*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].cs
*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].script.json
*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].object.json

# Test files titled "Name <8 hex>"
*[ ][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].json
*[ ][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].cs

# Byte-code from running the CI scripts by hand.
__pycache__/
*.pyc

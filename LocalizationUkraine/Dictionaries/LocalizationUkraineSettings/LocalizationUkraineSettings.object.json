    {
      "dictionaryMetaId": "b3823cc5-e789-4a7c-b626-2a639f7836ca",
      "fieldName": "SingleTaxCodeExcess",
      "baseType": "String",
      "length": 64,
      "isSystem": false,
      "isRequired": false,
      "displayOrder": 5,
      "description": "Код налога (TaxCode.Code) для ставки 15% на ПРЕВЫШЕНИЕ годового предела (ПКУ 293.4). Поставочное значение — UA-EP15. Пусто или кода нет — превышение не выделяется и весь доход идёт по обычной ставке, как до появления предела.",
      "isIndexed": false,
      "isUnique": false,
      "caption": {
        "en": "Single tax code, 15% (over the limit)",
        "ar": "رمز الضريبة الموحدة 15% (تجاوز الحد)",
        "ru": "Код единого налога 15% (превышение)",
        "uk": "Код єдиного податку 15% (перевищення)"
      },
      "isTranslatable": false,
      "isVisible": true,
      "isCalculated": false,
      "metaId": "ea726dcc-6c99-4977-a958-2a891e8b7e82",
      "name": "SingleTaxCodeExcess",
      "modelId": "1d269769-c682-4655-be04-4e00fd39eb08"
    },
    {
      "dictionaryMetaId": "b3823cc5-e789-4a7c-b626-2a639f7836ca",
      "fieldName": "ExemptVatCode",
      "baseType": "String",
      "length": 64,
      "isSystem": false,
      "isRequired": false,
      "displayOrder": 6,
      "description": "Код налога (TaxCode.Code) для освобождения от ПДВ. Пакет ставит его сопоставлением на юрлицо, когда режим не платит ПДВ (спрощена 5% или загальна без ПДВ), и снимает, когда режим снова плательщик. Поставочное значение — UA-E. Пусто или кода нет — сопоставление не заводится, и общий путь Sales → Tax берёт DefaultTaxCode: в леджере у неплательщика оказался бы ПДВ.",
      "isIndexed": false,
      "isUnique": false,
      "caption": {
        "en": "Exempt VAT code (no-VAT regimes)",
        "ar": "رمز ضريبة القيمة المضافة المعفاة (الأنظمة بدون ضريبة)",
        "ru": "Код освобождения от НДС (режимы без НДС)",
        "uk": "Код звільнення від ПДВ (режими без ПДВ)"
      },
      "isTranslatable": false,
      "isVisible": true,
      "isCalculated": false,
      "metaId": "7f4e2c91-b8a3-4d16-9e50-2c6f8a1b3d09",
      "name": "ExemptVatCode",
      "modelId": "1d269769-c682-4655-be04-4e00fd39eb08"
    },
    {
      "dictionaryMetaId": "b3823cc5-e789-4a7c-b626-2a639f7836ca",
      "fieldName": "VatReturnType",
      "baseType": "String",
      "length": 32,
      "isSystem": false,
      "isRequired": false,
      "displayOrder": 6,
      "description": "Тип декларации для выгрузки — тот же код, что в TaxReportMapping.ReturnType. Именно он решает, по какому набору ячеек собиралась декларация, поэтому кнопка выгрузки берёт его отсюда, а не из своих настроек: разъехаться эти два места не должны. Пусто — выгрузка откажется работать и скажет почему.",
      "isIndexed": false,
      "isUnique": false,
      "caption": {
        "en": "Return type for export",
        "ar": "نوع الإقرار للتصدير",
        "ru": "Тип декларации для выгрузки",
        "uk": "Тип декларації для вивантаження"
      },
      "isTranslatable": false,
      "isVisible": true,
      "isCalculated": false,
      "metaId": "a8587cfb-a9e0-41ce-8078-b10e8287154b",
      "name": "VatReturnType",
      "modelId": "1d269769-c682-4655-be04-4e00fd39eb08"
    },
    {
      "dictionaryMetaId": "b3823cc5-e789-4a7c-b626-2a639f7836ca",
      "fieldName": "IncomeTaxCode",
      "baseType": "String",
      "length": 64,
      "isSystem": false,
      "isRequired": false,
      "displayOrder": 7,
      "description": "Код налога (TaxCode.Code) для ПДФО, удерживаемого из зарплаты. Ставка берётся из контура НА ДАТУ НАЧИСЛЕНИЯ. Пусто или код не найден — удержание не выполняется вовсе, и это единственный выключатель контура: модель не гадает по стране юрлица.",
      "isIndexed": false,
      "isUnique": false,
      "caption": {
        "en": "Personal income tax code (payroll)",
        "ar": "رمز ضريبة الدخل الشخصي (الرواتب)",
        "ru": "Код НДФЛ (зарплата)",
        "uk": "Код ПДФО (зарплата)"
      },
      "isTranslatable": false,
      "isVisible": true,
      "isCalculated": false,
      "metaId": "d37c09fe-ac25-4282-964a-9b95d84d2f25",
      "name": "IncomeTaxCode",
      "modelId": "1d269769-c682-4655-be04-4e00fd39eb08"
    },
    {
      "dictionaryMetaId": "b3823cc5-e789-4a7c-b626-2a639f7836ca",
      "fieldName": "MilitaryLevyCode",
      "baseType": "String",
      "length": 64,
      "isSystem": false,
      "isRequired": false,
      "displayOrder": 8,
      "description": "Код налога (TaxCode.Code) для военного сбора. Отдельным кодом, а не общей суммой с ПДФО: сборы идут в разные бюджеты и в разные строки расчёта, а ставка ВЗ менялась (1,5% до 01.12.2024, далее 5%) независимо от ПДФО.",
      "isIndexed": false,
      "isUnique": false,
      "caption": {
        "en": "Military levy code (payroll)",
        "ar": "رمز الرسم العسكري (الرواتب)",
        "ru": "Код военного сбора (зарплата)",
        "uk": "Код військового збору (зарплата)"
      },
      "isTranslatable": false,
      "isVisible": true,
      "isCalculated": false,
      "metaId": "3421b5d1-121c-4c74-b0a9-343cc062a432",
      "name": "MilitaryLevyCode",

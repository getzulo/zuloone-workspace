    {
      "documentTypeMetaId": "34a1af4c-aeaf-48d1-8626-9a0a13b2d5c3",
      "fieldName": "LegalEntity",
      "caption": {
        "en": "Selling legal entity",
        "ar": "الكيان القانوني البائع",
        "ru": "Юрлицо продавца",
        "uk": "Юрособа продавця"
      },
      "edtMetaId": "4ddbfca6-2464-452f-b913-443463c0094f",
      "isSystem": false,
      "isRequired": false,
      "displayOrder": 3,
      "description": "Кто продаёт. Заполняется автоматически при выставлении — по цепочке Ячейка → Зона → Склад → Подразделение → Юрлицо. Поле нужно ИМЕННО НА ДОКУМЕНТЕ, потому что налоговый леджер разрезан юрлицом, а транзакционный скрипт синхронный и пройти эту цепочку не может. Заполнено вручную — цепочка не переписывает: ячейка отгрузки и продавец совпадают не всегда.",
      "isIndexed": false,
      "isUnique": false,
      "isVisible": true,
      "isTranslatable": false,
      "metaId": "5e3a7c81-9b24-4d06-8f57-1c9e2b6a4d38",

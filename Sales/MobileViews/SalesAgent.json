  ],
  "entities": [
    { "name": "Item", "mode": "Master", "fields": [] },
    { "name": "Customer", "mode": "Master", "fields": [] },
    { "name": "CustomerOutlet", "mode": "Master", "fields": [] },
    { "name": "Address", "mode": "Master", "fields": [] },
    { "name": "SalesContract", "mode": "Master", "fields": [] },
    { "name": "SalesPerson", "mode": "Master", "fields": [] },
    { "name": "VisitRoute", "mode": "Transactional", "fields": [] },
    { "name": "AgentVisit", "mode": "Transactional", "fields": [] },
    { "name": "SalesOrder", "mode": "Transactional", "fields": [] },
    { "name": "CachedPrice", "mode": "Projection", "fields": ["ItemId","UnitId","CustomerId","ContractId","MinQty","UnitPrice","Source","Explanation","ListPrice","QtyDiscountPercent"] }

    { "name": "SharePdf", "entity": "SalesOrder" },
    { "name": "StartShift" },
    { "name": "EndShift" }
  ],
  "expressions": [
    { "target": "SalesOrderLines.LineAmount", "formula": "round(Quantity * UnitPrice * (1 - DiscountPercent / 100), 2)" },
    { "target": "SalesOrder.HeaderTotal", "formula": "sum(Lines.LineAmount)" }
  ],
  "layouts": {}
